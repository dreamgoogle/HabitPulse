{
  "name": "habitpulse",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "HabitPulse — daily habit tracker with Google sign-in, per-user cloud sync and CSV/Sheets export.",
  "scripts": {
    "dev": "vite",
    "emulators": "firebase emulators:start --only auth,firestore,functions --project habitpulse-local",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "npm run build && firebase deploy --only hosting:app",
    "deploy:admin": "cd admin && npm run build && cd .. && firebase deploy --only hosting:admin",
    "icons": "node scripts/generate-icons.mjs",
    "test": "firebase emulators:exec --only firestore --project habitpulse-rules-test \"node --test tests/*.test.js\"",
    "test:watch": "firebase emulators:exec --only firestore --project habitpulse-rules-test \"node --test --watch tests/*.test.js\""
  },
  "dependencies": {
    "firebase": "^11.6.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^15.34.0",
    "sharp": "^0.35.5",
    "vite": "^5.4.11"
  }
}
