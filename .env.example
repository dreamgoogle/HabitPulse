# Copy this file to .env.local
#
# ─────────────────────────────────────────────────────────────────────────
# RAASTA 1 — Local testing, bina kisi cloud project ke (sabse aasan)
#
#   .env.local mein sirf itna likhiye:
#       VITE_USE_EMULATORS=true
#
#   ...phir DO terminal chahiye:
#       Terminal 1:  npm run emulators
#       Terminal 2:  npm run dev
#
#   Neeche ki saari values ignore ho jayengi. Koi Firebase account, koi
#   billing, kuch nahi chahiye.
# ─────────────────────────────────────────────────────────────────────────
VITE_USE_EMULATORS=false

# Emulators kis host par chal rahe hain (phone se test karna ho to apne laptop
# ka LAN IP daaliye, jaise 192.168.1.5)
VITE_EMULATOR_HOST=127.0.0.1

# ─────────────────────────────────────────────────────────────────────────
# RAASTA 2 — Asli Firebase project
# Firebase Console → Project settings → General → Your apps → Web app
#                  → SDK setup and configuration
# ─────────────────────────────────────────────────────────────────────────

VITE_FB_API_KEY=AIzaSy...
VITE_FB_AUTH_DOMAIN=habitpulse.firebaseapp.com
VITE_FB_PROJECT_ID=habitpulse
VITE_FB_STORAGE_BUCKET=habitpulse.firebasestorage.app
VITE_FB_SENDER_ID=000000000000
VITE_FB_APP_ID=1:000000000000:web:abcdef123456

# Cloud Functions region (Mumbai = India users ke liye sabse kam latency)
VITE_FB_REGION=asia-south1

# Google One Tap ke liye OAuth Web Client ID (optional — bina iske bhi popup sign-in chalta hai).
# Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration
VITE_GOOGLE_CLIENT_ID=000000000000-abcdef.apps.googleusercontent.com

# NOTE: Firebase web apiKey secret nahi hoti — wo public hona normal hai.
# Asli security firestore.rules se aati hai, is file ko chhupane se nahi.
